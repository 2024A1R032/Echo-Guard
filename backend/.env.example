# Copy this file to backend/.env and fill in your own values. Never commit .env.
# The backend connects to PostgreSQL with these four settings (port 5432).
POSTGRES_SERVER=localhost
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=echoguard

# Optional: lets the LangGraph step write reports with a real language model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
